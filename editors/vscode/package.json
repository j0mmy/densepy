{
  "name": "densepy-vscode",
  "displayName": "DensePy",
  "description": "Syntax highlighting for DensePy .gpy files.",
  "version": "0.1.0",
  "publisher": "densepy",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Programming Languages"],
  "main": "./extension.js",
  "activationEvents": ["onLanguage:densepy"],
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "contributes": {
    "languages": [
      {
        "id": "densepy",
        "aliases": ["DensePy", "gpy"],
        "extensions": [".gpy"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "densepy",
        "scopeName": "source.gpy",
        "path": "./syntaxes/gpy.tmLanguage.json"
      }
    ]
  }
}
